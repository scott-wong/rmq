<h1><%= t('User') %>: <b><%= fmt_string(user.name) %></b></h1>

<% if (permissions.length == 0) { %>
<p class="warning">
  <%= t('This user does not have permission to access any virtual hosts.') %><br/>
  <%= t('Use "Set Permission" below to grant permission to access virtual hosts.') %>
</p>
<% } %>

<div class="section">
  <h2><%= t('Overview') %></h2>
  <div class="hider">
<table class="facts">
  <tr>
    <th><%= t('Tags') %></th>
    <td><%= fmt_string(user.tags) %></td>
  </tr>
  <tr>
    <th><%= t('Can log in with password') %></th>
    <td><%= fmt_boolean(user.has_password) %></td>
  </tr>
</table>
  </div>
</div>

<%= format('permissions', {'mode': 'user', 'permissions': permissions, 'vhosts': vhosts, 'parent': user}) %>

<%= format('topic-permissions', {'mode': 'user', 'topic_permissions': topic_permissions, 'vhosts': vhosts, 'parent': user, 'exchanges': exchanges}) %>

<div class="section-hidden">
  <h2><%= t('Update this user') %></h2>
  <div class="hider">
    <form action="#/users-modify" method="put">
      <input type="hidden" name="username" value="<%= fmt_string(user.name) %>"/>
      <table class="form">
        <tr>
          <th>
            <label>
              <select name="has-password" class="narrow controls-appearance">
                <% if (user.has_password) { %>
                <option value="password" selected="selected"><%= t('Password:') %></option>
                <option value="no-password"><%= t('No password') %></option>
                <% } else { %>
                <option value="password"><%= t('Password:') %></option>
                <option value="no-password" selected="selected"><%= t('No password') %></option>
                <% } %>
              </select>
            </label>
          </th>
          <td>
            <% if (user.has_password) { %>
            <div id="password-div">
            <% } else { %>
            <div id="password-div" style="display: none;">
            <% } %>
              <input type="password" name="password" />
              <span class="mand">*</span><br/>
              <input type="password" name="password_confirm" />
              <span class="mand">*</span>
              (<%= t('confirm') %>)
            </div>
            <% if (user.has_password) { %>
            <div id="no-password-div" style="display: none;">
            <% } else { %>
            <div id="no-password-div">
            <% } %>
              <%= t('User cannot log in using password.') %>
            </div>
          </td>
        </tr>
        <tr>
          <th><label><%= t('Tags:') %></label></th>
          <td>
            <input type="text" name="tags" id="tags" value="<%= fmt_string(user.tags) %>" />
            <span class="help" id="user-tags"/>
            <sub>
              [<span class="tag-link" tag="administrator"><%= t('Admin') %></span>]
              [<span class="tag-link" tag="monitoring"><%= t('Monitoring') %></span>]
              [<span class="tag-link" tag="policymaker"><%= t('Policymaker') %></span>]
              [<span class="tag-link" tag="management"><%= t('Management') %></span>]
              [<span class="tag-link" tag="impersonator"><%= t('Impersonator') %></span>]
              [<span class="tag-link" tag=""><%= t('None') %></span>]
            </sub>
          </td>
        </tr>
      </table>
      <input type="submit" value="<%= t('Update user') %>"/>
    </form>
  </div>
</div>

<div class="section-hidden">
  <h2><%= t('Delete this user') %></h2>
  <div class="hider">
    <form action="#/users" method="delete" class="confirm">
      <input type="hidden" name="username" value="<%= fmt_string(user.name) %>"/>
      <input type="submit" value="<%= t('Delete') %>"/>
    </form>
  </div>
</div>
